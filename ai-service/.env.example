# Google Gemini API Key for Embeddings and LLM Generation
# Replace with your actual key in a local .env file (DO NOT commit real keys to git)
GEMINI_API_KEY=${GEMINI_API_KEY}

# Shared secret required on every AI endpoint via the X-Internal-Api-Key
# header. The Spring backend sends it; the service refuses to start
# without it. Must be at least 32 characters and match the backend's
# AI_SERVICE_INTERNAL_API_KEY.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_PLUS_CHAR_KEY

# Comma separated list of browser origins allowed to call this service
# directly. Normally nothing should: browsers talk to Spring on :8080.
# A "*" value is ignored on purpose.
AI_ALLOWED_ORIGINS=http://localhost:3000
