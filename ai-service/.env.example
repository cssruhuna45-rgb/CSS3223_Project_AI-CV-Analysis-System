# Google Gemini API Key for Embeddings and LLM Generation
# Replace with your actual key in a local .env file (DO NOT commit real keys to git)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Shared secret required on every AI endpoint via the X-Internal-Api-Key
# header. The Spring backend sends it; the service refuses to start
# without it. Must be at least 32 characters and match the backend's
# AI_SERVICE_INTERNAL_API_KEY.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=YOUR_GENERATED_INTERNAL_API_KEY_HERE

# Comma separated list of browser origins allowed to call this service
# directly. Normally nothing should: browsers talk to Spring on :8080.
# A "*" value is ignored on purpose.
AI_ALLOWED_ORIGINS=http://localhost:3000

# Which Gemini model to use. Leave unset for the default.
# Set this when the current model starts returning 503 "high demand" -
# list what your key can reach with:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY"
# Prefer a pinned name over a "-latest" alias; the aliases get throttled first.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Seconds to wait for one Gemini call, and retries inside the client.
# Without a timeout a busy model makes the request hang instead of failing.
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_RETRIES=1
