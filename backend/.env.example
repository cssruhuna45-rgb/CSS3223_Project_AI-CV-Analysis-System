# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ai_interview_db
DB_USERNAME=postgres
DB_PASSWORD=postgrespassword

# File Storage Directory Configuration
FILE_UPLOAD_DIR=uploads/resumes/

# Signs every login token, so anyone holding it can mint a token for any
# account without a password. Required - the backend refuses to start
# without it. This file used to carry a working key, which meant every
# clone shared one that is published on GitHub.
#
# Generate your own (base64, at least 32 bytes decoded):
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET=YOUR_GENERATED_JWT_SECRET_HERE
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call this API (comma separated).
# Never use "*" here: this API accepts credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Copy this file to backend/.env and the app reads it on startup
# (spring.config.import in application.yml). Real environment variables
# still win, so Docker and CI can override anything here.

# Shared secret sent to the AI service as the X-Internal-Api-Key header.
# MUST match INTERNAL_API_KEY in ai-service/.env. The backend refuses to
# start without it, so the AI service is never called unauthenticated.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_INTERNAL_API_KEY=YOUR_GENERATED_INTERNAL_API_KEY_HERE
