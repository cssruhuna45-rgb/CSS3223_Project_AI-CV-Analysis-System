# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/ai_interview_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgres_password_here

# File Storage Directory Configuration
FILE_UPLOAD_DIR=uploads/resumes/

# JWT Configuration (Secret should be at least 256-bit / 32 bytes base64 or hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Browser origins allowed to call this API (comma separated).
# Never use "*" here: this API accepts credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Python FastAPI AI Service URL
AI_SERVICE_URL=http://localhost:8000

# Shared secret sent to the AI service as the X-Internal-Api-Key header.
# MUST match INTERNAL_API_KEY in ai-service/.env. The backend refuses to
# start without it, so the AI service is never called unauthenticated.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_INTERNAL_API_KEY=CHANGE_ME_MUST_MATCH_AI_SERVICE_INTERNAL_API_KEY
