# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview_db?schema=public"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379"

# AI Provider API Keys
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
OPENAI_API_KEY="sk-proj-YOUR_OPENAI_API_KEY_HERE"

# Security & Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production"

# Shared secret between the Spring backend and the FastAPI AI service.
# docker-compose passes this to both containers; the AI service refuses
# every request without it and neither service starts unless it is set.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY="YOUR_GENERATED_INTERNAL_API_KEY_HERE"
# Browser origins allowed to call the Spring API (comma separated).
# Never "*": the API accepts credentials.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
