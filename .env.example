# Copy to .env beside docker-compose.yml and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.


# ------------------------------------------------------------------
# Required - docker compose refuses to start without these
# ------------------------------------------------------------------

# Google Gemini key for question generation, grading and CV review.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Shared secret between the Spring backend and the FastAPI AI service.
# The AI service rejects every request that does not carry it, which is
# what keeps the Gemini budget from being spent by anyone who can reach
# port 8000. Must be at least 32 characters.
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=YOUR_GENERATED_INTERNAL_API_KEY_HERE

# Signs the login tokens. Anyone holding this can mint a token for any
# account, so generate a fresh one rather than reusing an example.
#
# Use base64 rather than token_urlsafe: the backend reads the secret as
# Base64 first, and a urlsafe token's '-' and '_' are outside that
# alphabet. Must decode to at least 32 bytes.
#
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(48)).decode())"
JWT_SECRET=YOUR_GENERATED_JWT_SECRET_HERE


# ------------------------------------------------------------------
# Optional - sensible defaults, override only if you need to
# ------------------------------------------------------------------

# Database password. The default is fine for local development; change
# it anywhere the port is reachable from outside the machine.
POSTGRES_PASSWORD=postgrespassword

# Browser origins allowed to call the Spring API, comma separated.
# Never "*": the API accepts credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Where the browser sends API calls. Baked into the frontend bundle at
# build time, so changing it needs `docker compose build frontend`.
# Set it to the machine's address if you open the app from another
# device - "localhost" would then mean that device, not the server.
REACT_APP_API_URL=http://localhost:8080

# Gemini model override. Blank uses the default in app/llm_config.py.
GEMINI_MODEL=
